{
  "id": "blood-pressure",
  "name": "Blood pressure",
  "icon": "heart-outline",
  "kind": "log",
  "fields": [
    {
      "key": "systolic",
      "label": "Systolic",
      "type": "integer",
      "unit": "mmHg",
      "min": 60,
      "max": 260,
      "required": true
    },
    {
      "key": "diastolic",
      "label": "Diastolic",
      "type": "integer",
      "unit": "mmHg",
      "min": 30,
      "max": 160,
      "required": true
    },
    {
      "key": "pulse",
      "label": "Pulse",
      "type": "integer",
      "unit": "bpm",
      "min": 25,
      "max": 220
    },
    {
      "key": "arm",
      "label": "Arm",
      "type": "choice",
      "options": [
        "left",
        "right"
      ]
    },
    {
      "key": "woke",
      "label": "Woke up",
      "type": "text",
      "hint": "8:30 or 30 min ago \u2014 for a morning reading",
      "quick": [
        "just now",
        "15 min ago",
        "30 min ago",
        "1 hour ago"
      ]
    },
    {
      "key": "notes",
      "label": "Notes",
      "type": "text",
      "hint": "Anything that might matter: coffee, stress, salty dinner, bad sleep\u2026"
    }
  ],
  "summary": "{systolic}/{diastolic} \u00b7 pulse {pulse} \u00b7 {arm} arm \u00b7 woke {woke}",
  "patterns": [
    "(?<systolic>\\d{2,3})\\s*(?:/|over)\\s*(?<diastolic>\\d{2,3})(?:\\D{0,40}?(?:pulse|heart rate|hr|bpm)\\D{0,10}(?<pulse>\\d{2,3}))?\\s*$"
  ]
}
